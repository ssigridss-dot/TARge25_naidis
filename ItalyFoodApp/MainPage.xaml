<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ItalyFoodApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ItalyFoodApp.Models"
    Title="Italian Kitchen">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF8E7" Offset="0.0" />
            <GradientStop Color="#FFE0B2" Offset="0.5" />
            <GradientStop Color="#FFCDD2" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid
        RowDefinitions="Auto,Auto,*,Auto,Auto"
        Padding="20">

        <!-- PEALKIRI -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="4"
            Margin="0,10,0,10">

            <Label
                x:Name="TitleLabel"
                Text="Italian Kitchen"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#8B0000"
                HorizontalOptions="Center" />

            <Label
                x:Name="SubtitleLabel"
                Text="Taste the best of Italy"
                FontSize="16"
                TextColor="#5D4037"
                HorizontalOptions="Center" />

        </VerticalStackLayout>


        <!-- KEELEVALIK -->
        <HorizontalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            Spacing="10"
            Margin="0,5,0,10">

            <Button
                x:Name="EstonianButton"
                Text="🇪🇪 Eesti"
                Clicked="EstonianButton_Clicked"
                BackgroundColor="#8B0000"
                TextColor="White"
                CornerRadius="20"
                Padding="15,8" />

            <Button
                x:Name="EnglishButton"
                Text="🇬🇧 English"
                Clicked="EnglishButton_Clicked"
                BackgroundColor="#555555"
                TextColor="White"
                CornerRadius="20"
                Padding="15,8" />

        </HorizontalStackLayout>


        <!-- CAROUSEL -->
        <CarouselView
            x:Name="DishCarousel"
            Grid.Row="2"
            ItemsSource="{Binding Dishes}"
            PositionChanged="DishCarousel_PositionChanged"
            PeekAreaInsets="20"
            Loop="True">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:Dish">

                    <Frame
                        Margin="10,10,10,15"
                        Padding="0"
                        CornerRadius="25"
                        HasShadow="True"
                        BackgroundColor="White"
                        BorderColor="#E0A458">

                        <Grid
                            RowDefinitions="*,Auto,Auto,Auto"
                            Padding="0">

                            <!-- PILT -->
                            <Image
                                Grid.Row="0"
                                Source="{Binding ImageUrl}"
                                Aspect="AspectFill"
                                HeightRequest="300" />

                            <!-- NIMI -->
                            <Label
                                Grid.Row="1"
                                x:Name="DishNameLabel"
                                Text="{Binding Name}"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#8B0000"
                                HorizontalTextAlignment="Center"
                                Margin="15,15,15,5" />

                            <!-- KIRJELDUS -->
                            <Label
                                Grid.Row="2"
                                x:Name="DishDescriptionLabel"
                                Text="{Binding Description}"
                                FontSize="16"
                                TextColor="#5D4037"
                                HorizontalTextAlignment="Center"
                                Margin="15,0,15,15" />

                            <!-- INFO NUPP -->
                            <Button
                                Grid.Row="3"
                                Text="More information"
                                Clicked="DishButton_Clicked"
                                BackgroundColor="#8B0000"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="20"
                                Margin="30,0,30,20"
                                Padding="10" />

                        </Grid>

                    </Frame>

                </DataTemplate>
            </CarouselView.ItemTemplate>

        </CarouselView>


        <!-- INDICATOR -->
        <IndicatorView
            x:Name="DishIndicator"
            Grid.Row="3"
            IndicatorColor="#BDBDBD"
            SelectedIndicatorColor="#8B0000"
            IndicatorSize="10"
            HorizontalOptions="Center"
            Margin="0,5,0,10" />


        <!-- INFO -->
        <Label
            x:Name="SwipeLabel"
            Grid.Row="4"
            Text="Swipe to explore Italian dishes"
            FontSize="14"
            TextColor="#5D4037"
            HorizontalOptions="Center"
            Margin="0,0,0,10" />

    </Grid>

</ContentPage>