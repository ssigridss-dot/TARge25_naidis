<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="GemApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="GemApp">

    <Grid x:Name="RootGrid">

        <!-- Taustapilt -->
        <Image
            x:Name="ThemeBackground"
            Aspect="AspectFill"
            Opacity="0.70"
            InputTransparent="True" />

        <!-- Tausta värvikiht -->
        <BoxView
            x:Name="ThemeOverlay"
            Opacity="0.28"
            InputTransparent="True" />

        <!-- Mängu sisu -->
        <ScrollView>
            <VerticalStackLayout
                Padding="12"
                Spacing="12">

                <Label
                    Text="💎 GemApp"
                    FontSize="32"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="{DynamicResource TextColor}"
                    FontFamily="{DynamicResource GameFont}" />

                <Label
                    Text="Ühenda vähemalt kolm ühesugust kalliskivi!"
                    FontSize="13"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextColor}" />

                <!-- Punktid ja käigud -->
                <Border
                    StrokeThickness="0"
                    BackgroundColor="{DynamicResource CardColor}"
                    StrokeShape="RoundRectangle 16"
                    Padding="12">

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto">

                        <Label
                            Text="PUNKTID"
                            TextColor="{DynamicResource TextColor}" />

                        <Label
                            x:Name="MovesLabel"
                            Grid.Column="1"
                            Text="KÄIGUD: 0"
                            HorizontalTextAlignment="End"
                            TextColor="{DynamicResource TextColor}" />

                        <Label
                            x:Name="ScoreLabel"
                            Grid.Row="1"
                            Text="0 / 500"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextColor}" />

                        <ProgressBar
                            x:Name="ScoreProgress"
                            Grid.Row="1"
                            Grid.Column="1"
                            Progress="0"
                            VerticalOptions="Center"
                            ProgressColor="#E9A23B" />
                    </Grid>
                </Border>

                <Label
                    Text="Puuduta kahte kõrvuti kivi"
                    FontSize="13"
                    HorizontalOptions="Center"
                    TextColor="{DynamicResource TextColor}" />

                <!-- Kalliskivide mängulaud -->
                <Border
                    StrokeThickness="0"
                    BackgroundColor="{DynamicResource CardColor}"
                    StrokeShape="RoundRectangle 14"
                    Padding="5"
                    HorizontalOptions="Center">

                    <Grid
                        x:Name="GameBoard"
                        WidthRequest="320"
                        HeightRequest="320"
                        RowSpacing="3"
                        ColumnSpacing="3" />
                </Border>

                <Label
                    x:Name="StatusLabel"
                    Text="Vali esimene kalliskivi!"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextColor}" />

                <Label
                    Text="VALI OMA TEEMA"
                    FontAttributes="Bold"
                    FontSize="15"
                    HorizontalOptions="Center"
                    TextColor="{DynamicResource TextColor}" />

                <!-- Kolm kujundust -->
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="6">

                    <Button
                        Text="🌸 Lilleaed"
                        Clicked="OnLightThemeClicked"
                        FontSize="11"
                        Padding="3"
                        BackgroundColor="#F5C7DB"
                        TextColor="#49304F"
                        CornerRadius="12" />

                    <Button
                        Grid.Column="1"
                        Text="🌙 Öine meri"
                        Clicked="OnDarkThemeClicked"
                        FontSize="11"
                        Padding="3"
                        BackgroundColor="#18334D"
                        TextColor="White"
                        CornerRadius="12" />

                    <Button
                        Grid.Column="2"
                        Text="🎃 Halloween"
                        Clicked="OnHalloweenThemeClicked"
                        FontSize="11"
                        Padding="3"
                        BackgroundColor="#6A347A"
                        TextColor="#FFF0D0"
                        CornerRadius="12" />
                </Grid>

                <Button
                    Text="🔄 Alusta uut mängu"
                    Clicked="OnRestartClicked"
                    HeightRequest="48"
                    BackgroundColor="#7C5CC4"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>